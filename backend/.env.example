# GateVault Environment Configuration Template
# Copy to '.env' and populate with production credentials

# Database Engine: 'mysql' for MySQL (production/staging/Docker), or 'sqlite' for local dev
DB_ENGINE=mysql

# MySQL Database Configuration (Least Privilege Non-Root Application User)
DB_NAME=gatevault
DB_USER=gatevault_app
DB_PASSWORD=your_secure_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3306
DB_SSL=False
DB_CONN_MAX_AGE=300

# Backup & Retention Settings
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=14

# Security Settings
SECRET_KEY=replace-this-with-a-secure-random-key-in-production
DEBUG=False

# Google OAuth 2.0 Client ID (Optional)
GOOGLE_OAUTH_CLIENT_ID=
